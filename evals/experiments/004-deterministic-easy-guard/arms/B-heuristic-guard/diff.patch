+])
+
+// Synchronous deterministic check for easy-tier draft answers that
+// are too specialist for a casual party-trivia player to type. Same
+// shape as detectAnswerLeak / detectNumericAnswer: returns true when
+// the answer fails the easy bar and the caller should trigger repair.
+//
+// Narrower than the round-002 Haiku version on purpose — high
+// precision, lower recall — but adds zero LLM cost so it cannot pay
+// the unexplained "hard tier" tax we attributed to B-002.
+//
+// Patterns fired:
+//   - "Lifetime/Achievement/Honorary X Award" with a discipline word
+//     in the middle ("Lifetime Achievement Grammy Award" → the casual
+//     form drops "Grammy").
+//   - Regnal forms like "Constantine the Great" / "Henry IV" where
+//     the casual root is in REGNAL_CASUAL_FORMS.
+//   - Production / studio / label trailing tokens ("Desilu
+//     Productions", "Pixar Animation Studios").
+//   - Acronym answer (≤5 uppercase chars) whose spelled-out form
+//     appears in the question text — the question already gave the
+//     hint away to the spelled form.
+//   - Medical / scientific multi-word terms with a specialist tail
+//     ("Stockholm Syndrome").
+export function detectEasySpecialistHeuristic(
+  question: string,
+  correctAnswer: string
+): boolean {
+  const answer = correctAnswer.trim()
+  if (answer.length === 0) return false
+
+  const tokens = answer.split(/\s+/)
+  const lowerTokens = tokens.map((t) => t.toLowerCase().replace(/[.,'"]/g, ''))
+
+  // "X Y Award" multi-word with a discipline word in the middle.
+  if (
+    lowerTokens.length >= 3 &&
+    lowerTokens[lowerTokens.length - 1] === 'award' &&
+    lowerTokens.some((t) => AWARD_DISCIPLINE_TOKENS.has(t))
+  ) {
+    return true
+  }
+
+  // Regnal forms: "<casual-root> the <suffix>" or "<casual-root>
+  // <roman-numeral>".
+  if (lowerTokens.length >= 2 && REGNAL_CASUAL_FORMS.has(lowerTokens[0])) {
+    if (lowerTokens[1] === 'the') return true
+    if (/^[IVX]+$/.test(tokens[1] ?? '')) return true
+  }
+
+  // Production / studio / label tail.
+  if (
+    lowerTokens.length >= 2 &&
+    PRODUCTION_TAIL_TOKENS.has(lowerTokens[lowerTokens.length - 1])
+  ) {
+    return true
+  }
+
+  // Acronym with spelled-out form in the question.
+  if (
+    tokens.length === 1 &&
+    /^[A-Z]{2,5}$/.test(tokens[0])
+  ) {
+    // Look for the spelled-out form: the question contains words whose
+    // first letters spell the acronym in order, separated by other
+    // words. Cheap approximation: check if all the acronym letters
+    // appear as initials of words in the question.
+    const acronymLetters = tokens[0].split('')
+    const qWords = question.split(/\s+/).map((w) => w[0]?.toUpperCase())
+    let pos = 0
+    let matched = true
+    for (const letter of acronymLetters) {
+      const found = qWords.indexOf(letter, pos)
+      if (found < 0) {
+        matched = false
+        break
+      }
+      pos = found + 1
+    }
+    if (matched) return true
+  }
+
+  // Scientific / medical specialist tail.
+  if (
+    lowerTokens.length >= 2 &&
+    SCIENTIFIC_TAIL_TOKENS.has(lowerTokens[lowerTokens.length - 1])
+  ) {
+    return true
+  }
+
+  return false
